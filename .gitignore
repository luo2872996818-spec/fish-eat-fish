# =========================================================================
#  .gitignore —— 告诉 Git「这些文件不要上传」
#  规则：每行一个模式，以 / 开头表示从仓库根目录算起，# 开头是注释
# =========================================================================

# ---- 编辑器 / 系统产生的垃圾 ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- Node.js（v1 不依赖 node，留着是防止以后临时装了包污染仓库）----
node_modules/
npm-debug.log*
package-lock.json

# ---- Python（本地起 http.server 时可能产生）----
__pycache__/
*.pyc
.venv/
venv/

# ---- 本地临时目录 / 日志 ----
.tmp/
*.log
*.bak