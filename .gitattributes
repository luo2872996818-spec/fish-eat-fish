# =========================================================================
#  .gitattributes —— 统一"换行符"的格式
#  ------------------------------------------------------------------------
#  为什么要管这个：
#    Windows 用 CRLF 表示换行，Linux/Mac 用 LF。Git 默认会在两边自动转换，
#    结果就是每次提交都弹一堆 "LF will be replaced by CRLF" 的警告。
#
#  eol=lf 的意思是：**仓库里一律存 LF**，不管你在什么系统上改
#    → 警告消失
#    → GitHub Pages 服务器（Linux）拿到的是它原生的格式
#    → 以后如果加了 .sh 脚本，也不会有"换行符错误导致脚本跑不起来"这种玄学问题
# =========================================================================

* text=auto eol=lf

# 二进制文件绝对不能做换行符转换，否则文件会被损坏
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.mp3  binary
*.ogg  binary
*.wav  binary
*.woff binary
*.woff2 binary